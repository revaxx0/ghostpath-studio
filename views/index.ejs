<%- include('partials/header') %>
<% const mainGame = (games && games[0]) ? games[0] : null; %>
<% const heroImg = (mainGame && mainGame.image) ? mainGame.image : '/images/GhostPath.jpg'; %>
<% const trailerUrl = (mainGame && mainGame.trailer) ? mainGame.trailer : 'https://www.youtube.com/watch?v='; %>

<!-- ================= HERO ================= -->
<section class="hero" id="top">
  <div class="hero-bg" style="background-image:url('<%= heroImg %>')"></div>
  <div class="hero-shade"></div>
  <div class="hero-fog"></div>
  <div class="container">
    <div class="hero-inner">
      <span class="hero-kicker">
        <span class="kicker-line"></span>
        <span data-en="A GhostPath Studio Original" data-tr="GhostPath Studio Orijinali" data-jp="GhostPath Studio オリジナル" data-ru="Оригинал GhostPath Studio">A GhostPath Studio Original</span>
      </span>
      <h1 class="hero-title glitch" data-text="MAWBOUND">
        <span class="hero-title-main">MAWBOUND</span>
        <span class="hero-title-tag gradient-text" data-en="Don't follow the path — let it find you." data-tr="Yolu takip etme — bırak o seni bulsun." data-jp="道を追うな — 道に追われろ。" data-ru="Не следуй за путём — позволь ему найти тебя.">Don't follow the path — let it find you.</span>
      </h1>
      <p class="hero-sub" data-en="An atmospheric, story-driven horror experience. Every sound matters. Every shadow remembers. Are you ready to go inside?" data-tr="Atmosferik, hikaye odaklı bir korku deneyimi. Her ses önemlidir. Her gölge hatırlar. İçeri girmeye hazır mısın?" data-jp="空気のような、物語重視のホラー体験。すべての音が意味を持ち、すべての影が記憶する。中に入る準備はできているか？" data-ru="Атмосферный хоррор, основанный на сюжете. Каждый звук имеет значение. Каждая тень помнит. Готовы ли вы войти?">An atmospheric, story-driven horror experience. Every sound matters. Every shadow remembers. Are you ready to go inside?</p>
      <div class="hero-actions">
        <a href="#game" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1.5 6.5l5 3.5-5 3.5v-7z"/></svg>
          <span data-en="Enter the Game" data-tr="Oyuna Gir" data-jp="ゲームに入る" data-ru="Войти в игру">Enter the Game</span>
        </a>
        <a href="<%= trailerUrl %>" target="_blank" class="btn btn-ghost">
          <span data-en="Watch Trailer" data-tr="Fragmanı İzle" data-jp="予告編を見る" data-ru="Смотреть трейлер">Watch Trailer</span>
        </a>
        <a href="https://ghostpath.itch.io" target="_blank" class="btn btn-ghost">
          <span data-en="Itch.io →" data-tr="Itch.io →" data-jp="Itch.io →" data-ru="Itch.io →">Itch.io →</span>
        </a>
      </div>
      <div class="hero-social">
        <a href="https://www.youtube.com/@GhostPathStudio" target="_blank" aria-label="YouTube" class="hero-social-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
